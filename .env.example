# Ingest client (base) — the only credentials most pipelines need.
PROVY_API_KEY=provy_...
PROVY_URL=https://provy.ai

# Emission switch. The SDK stays silent unless this is truthy, so a local or dev run with
# production credentials never writes into your production Provy. Set to 1 only in production/CI.
PROVY_EMIT=1

# Client-side LLM-as-judge ([judge] extra) — only if you run the judge in-pipeline.
ANTHROPIC_API_KEY=sk-ant-...

# Legacy direct-DB path ([engine] extra) — prefer the ingest API above.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-key
# TENANT_ID=your-provy-tenant-uuid
# WORKFLOW_ID=your-provy-pipeline-uuid
